<?xml version="1.0" encoding="UTF-8"?>

<phpunit bootstrap="./Tests/bootstrap-php82.php"
         backupGlobals="false"
         backupStaticAttributes="false"
         convertErrorsToExceptions="true"
         convertNoticesToExceptions="true"
         convertWarningsToExceptions="true"
         processIsolation="false"
         stopOnFailure="true"
         colors="true">

    <testsuites>
        <testsuite name="XiideaEasyAuditBundle test suite">
            <directory suffix="Test.php">./Tests</directory>
        </testsuite>
    </testsuites>

    <coverage>
        <include>
            <directory suffix=".php">./Annotation</directory>
            <directory suffix=".php">./Common</directory>
            <directory suffix=".php">./DependencyInjection</directory>
            <directory suffix=".php">./Entity</directory>
            <directory suffix=".php">./Events</directory>
            <directory suffix=".php">./Listener</directory>
            <directory suffix=".php">./Logger</directory>
            <directory suffix=".php">./Model</directory>
            <directory suffix=".php">./Resolver</directory>
            <directory suffix=".php">./Subscriber</directory>
            <directory suffix=".php">./Traits</directory>
            <file>./XiideaEasyAuditBundle.php</file>
        </include>
    </coverage>
</phpunit>
